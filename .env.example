# Frontend
# Set this when frontend and API are hosted on different origins.
# Example: VITE_API_BASE_URL=https://api.your-domain.com
VITE_API_BASE_URL=

# Backend
# Bind host/port for shared access.
HOST=0.0.0.0
PORT=3001

# IMPORTANT: change in production.
ADMIN_TOKEN=change-me

# Optional: force absolute public API base URL in API responses.
# Example: PUBLIC_API_BASE_URL=https://api.your-domain.com
PUBLIC_API_BASE_URL=

# Allowed frontend origins for CORS.
# Use * for open access, or a comma-separated list in production.
# Example: CORS_ORIGIN=https://reader.your-domain.com,https://admin.your-domain.com
CORS_ORIGIN=*
