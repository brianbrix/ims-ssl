# Frontend
# Set this when frontend and API are hosted on different origins.
# Example: VITE_API_BASE_URL=https://api.your-domain.com
VITE_API_BASE_URL=

# Backend
# Bind host/port for shared access.
HOST=0.0.0.0
PORT=3001

# IMPORTANT: change in production.
ADMIN_TOKEN=change-me

# Optional: root directory for persistent storage.
# If set, app will store files in:
# - ${STORAGE_ROOT}/uploads
# - ${STORAGE_ROOT}/data/lessons.db
# Example for Wasmer volume mount: STORAGE_ROOT=/persistent
STORAGE_ROOT=

# Optional: force absolute public API base URL in API responses.
# Example: PUBLIC_API_BASE_URL=https://api.your-domain.com
PUBLIC_API_BASE_URL=

# Optional: PDF optimization mode for uploads.
# Values: none | lossless | screen | ebook | printer | prepress
# - lossless: linearize and optimize structure without quality loss.
# - screen/ebook/printer/prepress: Ghostscript compression profiles (lossy).
PDF_OPTIMIZE_MODE=lossless

# Optional: fail uploads if requested optimization tools are unavailable.
# Values: true/false
PDF_OPTIMIZE_STRICT=false

# Optional: allow optimized output even if it becomes larger than original.
# Values: true/false
# Recommended: false
PDF_OPTIMIZE_ALLOW_LARGER=false

# Allowed frontend origins for CORS.
# Use * for open access, or a comma-separated list in production.
# Example: CORS_ORIGIN=https://reader.your-domain.com,https://admin.your-domain.com
CORS_ORIGIN=*

# Traefik (Docker deployment)
# Public hostname routed by Traefik to this app.
# Example: APP_HOST=reader.your-domain.com
APP_HOST=


# Traefik TLS certificate resolver name.
# Example: TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_CERTRESOLVER=letsencrypt
